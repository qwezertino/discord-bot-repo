# Add profiles in the panel using these variable names. Never paste tokens into chat.
IRON_CROWN_BOT_TOKEN=
PERIMETER_BOT_TOKEN=

# Safe default for a VPS: connect through an SSH tunnel.
PANEL_HOST=127.0.0.1
PANEL_PORT=8765

# Required for non-localhost binding in local authentication mode.
PANEL_USERNAME=admin
PANEL_PASSWORD=

MAX_UPLOAD_MB=10
ALLOW_PRIVILEGED_REACTION_ROLES=false

# local: existing local/Basic administrator access; discord: individual Discord login.
# Set all OAuth values before switching to discord. Never paste the secret into chat.
PANEL_AUTH_MODE=local
PANEL_OWNER_DISCORD_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/auth/discord/callback
PANEL_SESSION_HOURS=12
